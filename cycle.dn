/*
 * Prompt para interagir com o pal.rest 
 */
const char DEFAULT_SERVER_IP[] = "127.0.0.1"
const int DEFAULT_SERVER_PORT = 8008

const char GET_CONFIG[] = "get_config"
const char GET_CONFIGS[] = "get_all_configs"
const char SET_CONFIG[] = "set_config"
const char GET_PERCEPTION_DATA[] = "get_perception_data"
const char TEST[] = "test"
const char UCB1[] = "ucb1"

component provides App requires pal.control.RestAPI, io.Output out, data.IntUtil iu, io.Input in, data.StringUtil strUtil,
	time.Timer timer, data.DecUtil du, util.Math math {

	RestAPI restAPI
	String configs[]

	void interpret(char cmd[]) {
		String helper[] = strUtil.explode(cmd, " ")
		if (helper.arrayLength == 1)
			execute(helper[0].string, 11)
		else if (helper.arrayLength == 2)
			execute(helper[0].string, iu.intFromString(helper[1].string))
		else
			out.println("ERROR!")
	}

	void execute(char cmd[], int op) {
		if (cmd == GET_CONFIG) {
			out.println("current: $(restAPI.getConfig())")
		} else if (cmd == GET_CONFIGS) {
			configs = restAPI.getConfigs()
			for (int i = 0; i < configs.arrayLength; i++)
				out.println("$(iu.intToString(i)) - $(configs[i].string)")
		} else if (cmd == SET_CONFIG) {
			restAPI.setConfig(configs[op].string)
			out.println("configuracao alterada!")
		} else if (cmd == GET_PERCEPTION_DATA) {
			PerceptionData pData = restAPI.getPerception()
			for (int i = 0; i < pData.metrics.arrayLength; i++)
				out.println("$(pData.metrics[i].name): $(iu.intToString(pData.metrics[i].totalValue))")
		} else if (cmd == TEST) {
			out.println("Iniciando modo de teste...")
			dec results[] = new dec[](0.0,0.0)
			for(int i = 0; i < configs.arrayLength; i++) { // go through each config
				out.println("Modo: $(configs[i].string)")
				results = collectMetrics(i) // [hits, misses]
				printResults(results)
			}
		} else if (cmd == UCB1) { // refactor
			// setup
			int k = configs.arrayLength // number of components
			dec ucb1_values[] = new dec [k]
			int pull_count[] = new int [k]
			for (int i = 0; i < k; i++)
            	pull_count[i] = 0
			dec total_rewards[] = new dec [k]
			for (int i = 0; i < k; i++)
            	total_rewards[i] = 0.0
			int rounds = 1000
			int highest_index
			dec decround
			dec decpulls
			dec results[] = new dec [2]
			out.println("Iniciando teste ucb1:")
			// main loop
			for (int i = 1; i < rounds + 1; i++) {
				out.println("Round $(i)")
				// update ucb values
				decround = i
				for (int arms = 0; arms < k; arms++) {
					decpulls = pull_count[arms]
					ucb1_values[arms] = calculate_ucb1(total_rewards[arms], pull_count[arms], decround)
				}
				// find highest
				highest_index = max(ucb1_values, k)
				// pull highest valued arm and add reward
				results = collectMetrics(highest_index)
				pull_count[highest_index] = pull_count[highest_index] + 1
				total_rewards[highest_index] = total_rewards[highest_index] + results[0]
			}
			char toPrint[]
			out.println("Pull counts:")
			for (int i = 0; i < k; i++) {
				toPrint = iu.makeString(pull_count[i])
				out.println(toPrint)
			}
			out.println("Accumulated rewards:")
			for (int i = 0; i < k; i++) {
				toPrint = iu.makeString(total_rewards[i])
				out.println(toPrint)
			}

		} else {
			out.println("ERROR!")
		}
	}

	dec[] collectMetrics(int index) {
		PerceptionData pData
		restAPI.setConfig(configs[index].string) // set_config to index
		dec hits = 0
		dec misses = 0
		dec results[] = new dec[](0.0,0.0)
		timer.sleep(10)
		pData = restAPI.getPerception()
		for (int j = 0; j < pData.metrics.arrayLength; j++) {
			if (pData.metrics[j].name == "hits") {
				hits = pData.metrics[j].totalValue
			}
			if (pData.metrics[j].name == "misses") {
				misses = pData.metrics[j].totalValue
			}
		}
		results[0] = hits
		results[1] = misses
		return results
	}

	void printResults(dec results[]) {
		dec total = results[0] + results[1]
		out.println("Hits: $(iu.intToString(results[0]))")
		out.println("Misses: $(iu.intToString(results[1]))")
		out.println("Total: $(iu.intToString(total))")
		if (total > 0) {
			out.println("Hit Rate: $(du.makeString(results[0]/total))")
		}
	}

	dec calculate_ucb1(dec total_reward, dec pull_count, int round) {
		dec updated_value
        if (pull_count > 0)
            updated_value = (total_reward / pull_count) + math.sqrt( (2 * math.log(round)) / pull_count )
        else
            updated_value = 0x3f3f3f3f
        
        return updated_value
	}

    int max(dec values[], int arms) 
    {
        dec max_value = values[0]
        int max_index = 0
        for (int i = 0; i < arms; i++)
        {
            if (values[i] > max_value)
            {
                max_value = values[i]
                max_index = i
            }
        }
        return max_index
    }

	int App:main(AppParam params[]) {
		restAPI = new RestAPI(DEFAULT_SERVER_IP, DEFAULT_SERVER_PORT)
		out.println("Sejam bem-vindos ao prompt test!")
		out.println("Os comandos sao:")
		out.println("$(GET_PERCEPTION_DATA) \t Para pegar o número de misses e hits gerado pelo componente de cache")
		out.println("$(GET_CONFIG) \t Para retornar a configuracao atual")
		out.println("$(GET_CONFIGS) \t Para retornar todas as possiveis configuracoes")
		out.println("$(SET_CONFIG) 0 \t Para adaptar para a primeira configuracao. \nNote que o 0 e o indice da lista retornada pelo get_all_configs\n")
		out.println("-> Note que voce so conseguira rodar o $(SET_CONFIG) se executar o $(GET_CONFIGS) pelo menos uma vez.")
		char cmd[]
		while (1) {
			out.print("cmd> ")
			cmd = in.readln()
			if (cmd == "exit") break
			interpret(cmd)
		}
		out.println("Obrigado por ter usado o prompt test. Bye! (:")
		return 0
	}
}