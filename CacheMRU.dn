component provides Cache(Destructor, AdaptEvents) requires io.Output out, data.IntUtil iu, pal.Perception perception {
    const char mode[] = "Most Recently Used (MRU)"
    CacheItem cache[]

    void initCache() {
        cache = new CacheItem[Cache.MAX_SIZE]
        pointer = 0
    }

    int Cache:get(int key) {
        if (cache == null) { initCache() }
        for (int i = 0; i < Cache.MAX_SIZE; i++) {
            if (cache[i] != null) {
                if (cache[i].key == key) {
                    CacheItem foundItem = cache[i]
                    for (int j = i; j < Cache.MAX_SIZE - 1; j++) { // shift left
                        cache[j] = cache[j + 1]
                    }
                    cache[Cache.MAX_SIZE - 1] = foundItem // MRU at the end
                    perception.addMetric("hits", 1, true)
                    return foundItem.value
                }
            } else { break }
        }
        perception.addMetric("misses", 1, false)
        add(new CacheItem(key, key))
        return INT_MAX
    }

    void Cache:add(store CacheItem item) {
        if (cache == null) { initCache() }
        int flag = 0

        for (int i = 0; i < Cache.MAX_SIZE; i++) {
            if (cache[i] != null && cache[i].key == item.key) { // already exists
                //cache[i] = item
                flag = 1
                break
            }
        }
        if (flag == 0) {
            for (int i = 0; i < Cache.MAX_SIZE; i++) {
                if (cache[i] == null) {
                    cache[i] = item
                    flag = 1
                    break
                }
            }
        }
        if (flag == 0) {
            //for (int i = 0; i < Cache.MAX_SIZE - 1; i++) { // shift left
            //    cache[i] = cache[i + 1]
            //}
            cache[Cache.MAX_SIZE - 1] = item // evict MRU element and add new item
        }
    }

    void Cache:printCache() {
        if (cache == null) { initCache() }
        out.println("$mode")
        out.print("[ ")
        for (int i = 0; i < Cache.MAX_SIZE; i++) {
            if (cache[i] != null) {
                out.print("$(iu.intToString(cache[i].key))-$(iu.intToString(cache[i].value))  ")
            }
        }
        out.print("]\n")
        out.println("---------------------------")
    }

    void clearList() {
        cache = null
        pointer = 0
    }

    void Destructor:destroy() {
		clearList()
	}
	
	void AdaptEvents:inactive() {
		content = cache
	}
	
	void AdaptEvents:active() {
		for (int i = 0; i < content.arrayLength; i++)
            add(content[i])
	}
	
}